<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /CarpinArt/public/

    # Si la petición no es un archivo ni directorio real, enviarla a index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>